# ============================================================
# Plantilla de variables de entorno — Área 3 (Orquestación)
# Copiar a .env y rellenar con valores reales.
# El .env real NUNCA se versiona (ver .gitignore).
# ============================================================

# --- Postgres (motor compartido) ---
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=cambiar_esta_clave

# --- Una base y un usuario por microservicio (Área 4) ---
CATALOGO_DB=catalogo_db
CATALOGO_DB_USER=catalogo_user
CATALOGO_DB_PASSWORD=cambiar_esta_clave

INVENTARIO_DB=inventario_db
INVENTARIO_DB_USER=inventario_user
INVENTARIO_DB_PASSWORD=cambiar_esta_clave

CLIENTES_DB=clientes_db
CLIENTES_DB_USER=clientes_user
CLIENTES_DB_PASSWORD=cambiar_esta_clave

PEDIDOS_DB=pedidos_db
PEDIDOS_DB_USER=pedidos_user
PEDIDOS_DB_PASSWORD=cambiar_esta_clave

REPORTES_DB=reportes_db
REPORTES_DB_USER=reportes_user
REPORTES_DB_PASSWORD=cambiar_esta_clave

# --- Puerto publicado por el gateway hacia el host ---
GATEWAY_PORT=8080

# --- Namespace de Docker Hub del grupo (Área 3) ---
DOCKERHUB_NAMESPACE=keinaro

# --- Flask ---
FLASK_ENV=production
